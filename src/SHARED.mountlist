/* SCSIToolbox-Amiga - SHARED: handler mountlist
 *
 * Mounts the BlueSCSI/ZuluSCSI Toolbox shared folder as an AmigaDOS volume.
 *
 * Install:
 *   - Copy the handler binary 'sharedfs' to L:  (e.g. Copy sharedfs L:sharedfs)
 *   - Mount with:  Mount SHARED: from SHARED.mountlist
 *     or install this entry (named "SHARED", no extension, with an icon) into
 *     DEVS:DOSDrivers/ for automatic mounting at boot.
 *
 * Set Device/Unit to YOUR SCSI adapter + the BlueSCSI/ZuluSCSI unit:
 *   A1200 Dataflyer in this project = ExpXDS.device, Unit 2.
 *   (e.g. scsi.device Unit 6, etc. on other setups.)
 *
 * The handler reads only Device + Unit (from the FileSysStartupMsg). The
 * geometry fields below are DUMMIES - OS 3.2's Mount refuses a FileSystem
 * entry without Surfaces/BlocksPerTrack/LowCyl/HighCyl (verified on hardware
 * 2026-08-06), but the handler never looks at them.
 */

SHARED:
FileSystem     = L:sharedfs
Device         = ExpXDS.device
Unit           = 2
Flags          = 0
Surfaces       = 1
BlocksPerTrack = 1
BlockSize      = 512
LowCyl         = 0
HighCyl        = 0
Buffers        = 1
GlobVec        = -1
StackSize      = 4096
Priority       = 5
DosType        = 0x53484152
Mount          = 1
#
